    "We'll show a notification while your baby sleeps, so you can quickly stop the timer when they wake up.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebeğiniz uyurken bir bildirim göstereceğiz, böylece uyandığında zamanlayıcıyı hızlıca durdurabilirsiniz."
          }
        }
      }
    },
